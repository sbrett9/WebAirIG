{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5090",
  "Consumer": {
    // Shared config folder (entity_catalog.json supplies YOLO class names), relative to this project folder.
    "SharedConfigDir": "../../config",
    "Receiver": { "Protocol": "udp", "BindAddress": "0.0.0.0", "Port": 5600, "AutoStart": true },
    // HwAccel: "cuda" (NVDEC), "d3d11va", "auto" or "none". FfmpegPath empty = WEBAIRIG_FFMPEG, winget, tools/ffmpeg, PATH.
    "Decoder": { "FfmpegPath": "", "HwAccel": "cuda" },
    // Export with: yolo export model=yolo26n.pt format=onnx imgsz=1024 (see tools/yolo). DeviceId -1 = CPU.
    "Detector": { "ModelPath": "../../models/yolo/yolo26n.onnx", "Enabled": true, "ConfidenceThreshold": 0.25, "NmsIouThreshold": 0.5, "DeviceId": 0 },
    "Evaluation": { "IouThreshold": 0.5, "IncludeOwnship": false, "MinTruthPixels": 4, "ClassAgnostic": true },
    "Recorder": { "OutputDir": "../../output/datasets", "DatasetName": "webairig", "EveryNFrames": 15, "Format": "jpg", "JpegQuality": 95, "IncludeOwnship": false, "MinBoxPixels": 3, "IncludeEmptyFrames": true },
    "Preview": { "MaxFps": 10, "JpegQuality": 80 }
  }
}
