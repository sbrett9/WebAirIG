@inherits ViewModelLayout<ShellViewModel>

<RadzenLayout class="webairig-layout">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="app-header">
            <RadzenSidebarToggle Click="@(() => Vm.ToggleSidebarCommand.Execute(null))" />
            <RadzenIcon Icon="flight" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">WebAirIG Host</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 app-subtitle">CIGI 4.0 host &middot; MWIR sensor control &middot; DIS</RadzenText>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="Vm.SidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Sensors &amp; Coverage" Icon="videocam" Path="" />
            <RadzenPanelMenuItem Text="Scenario" Icon="route" Path="scenario" />
            <RadzenPanelMenuItem Text="Status" Icon="monitor_heart" Path="status" />
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-3">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>
<RadzenNotification />
