@inherits ViewModelControl<Scene3DViewModel>
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="scene3d-toolbar">
    <RadzenSelectBar TValue="Scene3DMode" Data="@Vm.ModeOptions" @bind-Value="Vm.Mode" Size="ButtonSize.Small" />
    <span class="tb-group">
        <span class="tb-label" title="Length of the drawn camera frustums and field-of-regard surfaces">Frustum @Vm.FrustumLengthText</span>
        @if (Vm.Mode == Scene3DMode.Ownship)
        {
            <RadzenSlider TValue="double" @bind-Value="Vm.FrustumLengthM" Min="10m" Max="400m" Step="5" Style="width: 8rem" />
        }
        else
        {
            <RadzenSlider TValue="double" @bind-Value="Vm.FrustumLengthM" Min="500m" Max="40000m" Step="500" Style="width: 8rem" />
        }
    </span>
    <span class="tb-group" title="Draw entities larger than life so they stay visible when zoomed out">
        <span class="tb-label">Symbols</span>
        <RadzenDropDown TValue="double" Data="@Vm.SymbolScaleOptions" @bind-Value="Vm.SymbolScale" Style="width: 5.5rem" />
    </span>
    <span class="tb-group">
        <RadzenCheckBox TValue="bool" @bind-Value="Vm.ShowFor" Name="cbFor" /><RadzenLabel Text="Field of regard" Component="cbFor" />
        <RadzenCheckBox TValue="bool" @bind-Value="Vm.ShowFootprints" Name="cbFp" /><RadzenLabel Text="Footprints" Component="cbFp" />
        <RadzenCheckBox TValue="bool" @bind-Value="Vm.ShowLabels" Name="cbLbl" /><RadzenLabel Text="Labels" Component="cbLbl" />
        <RadzenCheckBox TValue="bool" @bind-Value="Vm.FollowHeading" Name="cbHdg" /><RadzenLabel Text="Turn with ownship" Component="cbHdg" />
    </span>
    <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="center_focus_strong" Text="Reset view"
                  Click="@(() => Vm.ResetViewCommand.Execute(null))" />
</div>

<div class="scene3d-wrap">
    <div class="scene3d-host" @ref="_host"></div>

    @if (Vm.HasSelection)
    {
        <div class="scene3d-selection">
            <div class="sel-head">
                <strong>@Vm.SelectedTitle</strong>
                <RadzenButton Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Icon="close"
                              Click="@(() => Vm.ClearSelectionCommand.Execute(null))" />
            </div>
            <div class="sel-detail">@Vm.SelectedDetail</div>
            @foreach (var r in Vm.SelectedReach)
            {
                <div class="sel-row @(r.InReach ? "" : "out")">
                    <span class="swatch" style="background:@r.Color"></span>
                    <span class="sel-cam">@r.CameraName</span>
                    <span class="sel-text">@r.Text</span>
                    @if (r.Tracking)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="TRACKING" />
                    }
                    else
                    {
                        <RadzenButton Size="ButtonSize.ExtraSmall" Text="Track" Disabled="@(!r.InReach)"
                                      Click="@(() => Vm.TrackWithCameraCommand.Execute(r.CameraId))" />
                    }
                </div>
            }
        </div>
    }

    <div class="scene3d-hint">Drag: orbit · right-drag: pan · wheel: zoom · click an aircraft: camera reach</div>
</div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private DotNetObjectReference<Scene3DView>? _self;
    private long _sentStep = -1;
    private int _sentOptions = -1, _sentReset = -1;
    private bool _busy, _disposed;

    // Pushes ViewModel state to the browser renderer after each render. One push at a time: renders that arrive while
    // a push is in flight are skipped, and the next 200 ms refresh carries the latest state.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_busy || _disposed) return;
        _busy = true;
        try
        {
            if (_view is null)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scene3d.js");
                _self = DotNetObjectReference.Create(this);
                _view = await _module.InvokeAsync<IJSObjectReference>("create", _host, Vm.Static, Vm.Options, _self);
                _sentOptions = Vm.OptionsRevision;
                _sentReset = Vm.ViewResetRevision;
            }
            if (_sentOptions != Vm.OptionsRevision)
            {
                _sentOptions = Vm.OptionsRevision;
                await _view.InvokeVoidAsync("setOptions", Vm.Options);
            }
            if (_sentReset != Vm.ViewResetRevision)
            {
                _sentReset = Vm.ViewResetRevision;
                await _view.InvokeVoidAsync("resetView");
            }
            var frame = Vm.Frame;
            if (frame.Step != _sentStep)
            {
                _sentStep = frame.Step;
                await _view.InvokeVoidAsync("update", frame);
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally { _busy = false; }
    }

    [JSInvokable]
    public void OnEntityClicked(int entityId)
    {
        if (entityId < 0) Vm.ClearSelectionCommand.Execute(null);
        else Vm.SelectEntityCommand.Execute(entityId);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Dispose();
        try
        {
            if (_view is not null)
            {
                await _view.InvokeVoidAsync("dispose");
                await _view.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
