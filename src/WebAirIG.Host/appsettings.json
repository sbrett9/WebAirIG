{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "WebAirIG": {
    // Folder holding world.json, entity_catalog.json, sensors.json, scenario.json (relative to this project folder).
    "SharedConfigDir": "../../config",
    "Cigi": {
      "IgAddress": "127.0.0.1",
      "IgPort": 8004,
      "HostPort": 8005,
      "FreeRunRateHz": 30,
      "IgTimeoutSeconds": 1.0,
      "PeriodicResendFrames": 30,
      "BigEndian": false
    },
    "Dis": {
      // Unicast to localhost by default. Use 255.255.255.255 (broadcast) or a 239.x.x.x group for a real DIS network.
      "Enabled": true,
      "Address": "127.0.0.1",
      "Port": 3000,
      "ExerciseId": 1,
      "SiteId": 1,
      "ApplicationId": 3001,
      "RateHz": 10
    }
  }
}
