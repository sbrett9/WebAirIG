<Project Sdk="Microsoft.NET.Sdk">
  <!-- net8.0 so it can be referenced by the Godot 4.7 C# project (net8.0) and the .NET 10 apps. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WebAirIG.Common</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WebAirIG.Tests" />
  </ItemGroup>
</Project>
