<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Godot.NET.Sdk / GodotSharp 4.7.2 are published on nuget.org, so the IG builds from a fresh clone
         without pointing NuGet at the (git-ignored) Godot install. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
