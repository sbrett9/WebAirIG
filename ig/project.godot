; Engine configuration file.
; WebAirIG image generator (Godot 4.7 .NET).

config_version=5

[application]

config/name="WebAirIG IG"
config/description="CIGI 4.0 pseudo-MWIR image generator with NVENC streaming and per-frame truth"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=30

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0
window/stretch/mode="disabled"

[dotnet]

project/assembly_name="WebAirIG.IG"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/size=256

[shader_globals]

ir_visibility_m={
"type": "float",
"value": 45000.0
}
ir_path_temp={
"type": "float",
"value": 0.3
}
ir_sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
